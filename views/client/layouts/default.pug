doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    title #{pageTitle}
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="keywords" content="")
    meta(name="description" content="")

    // Google Web Fonts
    link(href="https://fonts.googleapis.com" rel="preconnect")
    link(crossorigin="" href="https://fonts.gstatic.com" rel="preconnect")
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap")

    // Icon Font Stylesheet
    link(href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" rel="stylesheet")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css")

    // Libraries Stylesheet
    link(rel="stylesheet" href="/client/assets/lib/lightbox/css/lightbox.min.css")
    link(rel="stylesheet" href="/client/assets/lib/owlcarousel/assets/owl.carousel.min.css")

    // Customized Bootstrap Stylesheet
    link(rel="stylesheet" href="/client/assets/css/bootstrap.min.css")

    // Template Stylesheet
    link(rel="stylesheet" href="/client/assets/css/style.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")

    script.
      const domainCDN = "#{domainCDN}"

  body
    include ../partials/header.pug

    block main

    include ../partials/footer.pug

    // Back to Top
    a.btn.btn-primary.border-3.border-primary.rounded-circle.back-to-top(href="#")
      i.fa.fa-arrow-up
    // JavaScript Libraries
    script(src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js")
    script(src="/client/assets/lib/easing/easing.min.js")
    script(src="/client/assets/lib/waypoints/waypoints.min.js")
    script(src="/client/assets/lib/lightbox/js/lightbox.min.js")
    script(src="/client/assets/lib/owlcarousel/owl.carousel.min.js")
    script(src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js")
    // Template Javascript
    script(src="/client/assets/js/main.js")

