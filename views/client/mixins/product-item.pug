mixin product-item(item, colClass = "col-md-6 col-lg-4 col-xl-3")
  div(class=colClass)
    .rounded.position-relative.fruite-item
      a(href=`/product/detail/${item.slug}`)
        .fruite-img
          img.img-fluid.w-100.rounded-top(
            alt=item.name 
            src=`${domainCDN}${item.images[0]}`
            )
      .p-4.border.border-secondary.border-top-0.rounded-bottom
        h4(class="text-center") 
          a(href=`/product/detail/${item.slug}`) #{item.name}
        .d-flex.justify-content-between.flex-lg-wrap.inner-price
          if(item.priceNew)
            p.text-dark.fs-5.fw-bold.mb-0 #{item.priceNew.toLocaleString("vi-VN")}đ
        a(href=`/product/detail/${item.slug}` class="btn btn-primary border-2 border-secondary mt-1 py-2 px-4" style="display: block; margin-left: auto; margin-right: auto;") Xem chi tiết