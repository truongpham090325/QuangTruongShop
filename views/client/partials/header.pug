// Spinner Start
#spinner.show.w-100.vh-100.bg-white.position-fixed.translate-middle.top-50.start-50.d-flex.align-items-center.justify-content-center
  .spinner-grow.text-primary(role="status")
// Spinner End
// Navbar start
.container-fluid.fixed-top
  .container.topbar.bg-primary.d-none.d-lg-block
    .d-flex.justify-content-between
      .top-info.ps-2
        small.me-3
          i.fas.fa-map-marker-alt.me-2.text-secondary
          a.text-white(href="#") Phú Xuyên - Hà Nội
        small.me-3
          i.fas.fa-envelope.me-2.text-secondary
          a.text-white(href="#") truongpham090325@gmail.com
      .top-link.pe-2
        a.text-white(href="#")
          small.text-white.mx-2 Chính sách bảo mật
          | /
        a.text-white(href="#")
          small.text-white.mx-2 Điều khoản dịch vụ
          | /
        a.text-white(href="#")
          small.text-white.ms-2 Bán hàng và hoàn tiền
  .container.px-0
    nav.navbar.navbar-light.bg-white.navbar-expand-xl
      a.navbar-brand(href="index.html")
        h1.text-primary.display-6 Q.TruongShop
      button.navbar-toggler.py-2.px-3(
        data-bs-target="#navbarCollapse" 
        data-bs-toggle="collapse" 
        type="button"
        )
        span.fa.fa-bars.text-primary
      #navbarCollapse.collapse.navbar-collapse.bg-white
        .navbar-nav.mx-auto
          a.nav-item.nav-link.active(href="/") Trang chủ
          .nav-item.dropdown
            a.nav-link.dropdown-toggle(
              data-bs-toggle="dropdown" 
              href="#"
              ) Sản phẩm
            .dropdown-menu.m-0.bg-secondary.rounded-0
              each item in categoryProductList
                a.dropdown-item(href=`product/category/${item.slug}`) #{item.name}
        .d-flex.m-3.me-0
          button.btn-search.btn.border.border-secondary.btn-md-square.rounded-circle.bg-white.me-4(
            data-bs-target="#searchModal" 
            data-bs-toggle="modal"
            )
            i.fas.fa-search.text-primary
          a.position-relative.me-4.my-auto(href="#")
            i.fa.fa-shopping-bag.fa-2x
            span.position-absolute.bg-secondary.rounded-circle.d-flex.align-items-center.justify-content-center.text-dark.px-1(style="top: -5px; left: 15px; height: 20px; min-width: 20px;") 3
          a.my-auto(href="#")
            i.fas.fa-user.fa-2x
// Navbar End
// Modal Search Start
#searchModal.modal.fade(
  aria-hidden="true" 
  aria-labelledby="exampleModalLabel" 
  tabindex="-1"
  )
  .modal-dialog.modal-fullscreen
    .modal-content.rounded-0
      .modal-header
        h5#exampleModalLabel.modal-title Tìm kiếm bằng từ khóa
        button.btn-close(
          aria-label="Close" 
          data-bs-dismiss="modal" 
          type="button"
          )
      .modal-body.d-flex.align-items-center
        .input-group.w-75.mx-auto.d-flex
          input.form-control.p-3(
            aria-describedby="search-icon-1" 
            placeholder="Nhập từ khóa..." 
            type="search"
            )
          span#search-icon-1.input-group-text.p-3
            i.fa.fa-search
// Modal Search End
