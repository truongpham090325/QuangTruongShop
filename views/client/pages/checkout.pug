extends ../layouts/default.pug

block main
  // Single Page Header start
  .container-fluid.page-header.py-5
    h1.text-center.text-white.display-6 Đặt hàng
    ol.breadcrumb.justify-content-center.mb-0
      li.breadcrumb-item
        a(href="/") Trang chủ
      li.breadcrumb-item.active.text-white Đặt hàng
  // Single Page Header End
  // Checkout Page Start
  .container-fluid.py-5
    .container.py-5
      h1.mb-4 Chi tiết thanh toán
      form(action="#")
        .row.g-5
          .col-md-12.col-lg-6.col-xl-5
            .row
              .col-md-12.col-lg-6
                .form-item.w-100
                  label.form-label.my-3
                    | Họ tên
                    sup *
                  input.form-control(type="text")
              .col-md-12.col-lg-6
                .form-item.w-100
                  label.form-label.my-3
                    | Số điện thoại
                    sup *
                  input.form-control(type="text")
            .form-item
              label.form-label.my-3
                | Địa chỉ
                sup *
              input.form-control(type="text")
          .col-md-12.col-lg-6.col-xl-7
            .table-responsive
              table.table
                thead
                  tr
                    th(scope="col") ảnh
                    th(scope="col") Tên
                    th(scope="col") Giá
                    th(scope="col") Số lượng
                    th(scope="col") Đơn vị tính
                    th(scope="col") Tạm tính
                tbody
                  tr
                    th(scope="row")
                      .d-flex.align-items-center.mt-2
                        img.img-fluid.rounded-circle(
                          alt="" 
                          style="width: 90px; height: 90px;" 
                          src="/client/assets/img/vegetable-item-2.jpg"
                          )
                    td.py-5 Dưa hấu
                    td.py-5 200.000đ
                    td.py-5 2
                    td.py-5 kg
                    td.py-5 400.000đ
              .inner-discount(style="text-align: right;")
                span Giảm giá: 0đ
              .inner-total(style="text-align: right;")
                span Tổng tiền: <b>360.000đ<b> 
            .row.g-4.text-center.align-items-center.justify-content-center.border-bottom.py-3
              .col-12
                .form-check.text-start.my-3
                  input#paymentMethodMoney.form-check-input.bg-primary.border-0(
                    value="money" 
                    name="paymentMethod" 
                    type="radio"
                    )
                  label.form-check-label(for="paymentMethodMoney") Thanh toán khi nhận hàng
            .row.g-4.text-center.align-items-center.justify-content-center.border-bottom.py-3
              .col-12
                .form-check.text-start.my-3
                  input#paymentMethodZaloPay.form-check-input.bg-primary.border-0(
                    value="zalopay" 
                    name="paymentMethod" 
                    type="radio"
                    )
                  label.form-check-label(for="paymentMethodZaloPay") Thanh toán qua Zalopay
            .row.g-4.text-center.align-items-center.justify-content-center.border-bottom.py-3
              .col-12
                .form-check.text-start.my-3
                  input#paymentMethodVNPay.form-check-input.bg-primary.border-0(
                    value="vnpay" 
                    name="paymentMethod" 
                    type="radio"
                    )
                  label.form-check-label(for="paymentMethodVNPay") Thanh toán qua VNPay
            .row.g-4.text-center.align-items-center.justify-content-center.pt-4
              button.btn.border-secondary.py-3.px-4.text-uppercase.w-100.text-primary(type="button") Đặt hàng
  // Checkout Page End