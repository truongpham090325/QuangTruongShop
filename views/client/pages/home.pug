        .col-md-12.col-lg-7
          h1.mb-5.display-3.text-primary Hoa quả tươi 100%
          .position-relative.mx-auto
            input.form-control.border-2.border-secondary.w-75.py-3.px-4.rounded-pill(
              placeholder="Tìm kiếm" 
              )
