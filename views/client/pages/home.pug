extends ../layouts/default.pug

block main
  // Hero Start
  .container-fluid.py-5.mb-5.hero-header
    .container.py-5
      .row.g-5.align-items-center
        .col-md-12.col-lg-7
          h4.mb-3.text-secondary 100% Organic Foods
          h1.mb-5.display-3.text-primary Organic Veggies & Fruits Foods
          .position-relative.mx-auto
            input.form-control.border-2.border-secondary.w-75.py-3.px-4.rounded-pill(
              placeholder="Search" 
              type="number"
              )
            button.btn.btn-primary.border-2.border-secondary.py-3.px-4.position-absolute.rounded-pill.text-white.h-100(
              style="top: 0; right: 25%;" 
              type="submit"
              ) Submit Now
        .col-md-12.col-lg-5
          #carouselId.carousel.slide.position-relative(data-bs-ride="carousel")
            .carousel-inner(role="listbox")
              .carousel-item.active.rounded
                img.img-fluid.w-100.h-100.bg-secondary.rounded(
                  alt="First slide" 
                  src="/client/assets/img/hero-img-1.png"
                  )
                a.btn.px-4.py-2.text-white.rounded(href="#") Fruites
              .carousel-item.rounded
                img.img-fluid.w-100.h-100.rounded(
                  alt="Second slide" 
                  src="/client/assets/img/hero-img-2.jpg"
                  )
                a.btn.px-4.py-2.text-white.rounded(href="#") Vesitables
            button.carousel-control-prev(
              data-bs-slide="prev" 
              data-bs-target="#carouselId" 
              type="button"
              )
              span.carousel-control-prev-icon(aria-hidden="true")
              span.visually-hidden Previous
            button.carousel-control-next(
              data-bs-slide="next" 
              data-bs-target="#carouselId" 
              type="button"
              )
              span.carousel-control-next-icon(aria-hidden="true")
              span.visually-hidden Next
  // Hero End
  // Featurs Section Start
  .container-fluid.featurs.py-5
    .container.py-5
      .row.g-4
        .col-md-6.col-lg-3
          .featurs-item.text-center.rounded.bg-light.p-4
            .featurs-icon.btn-square.rounded-circle.bg-secondary.mb-5.mx-auto
              i.fas.fa-car-side.fa-3x.text-white
            .featurs-content.text-center
              h5 Free Shipping
              p.mb-0 Free on order over $300
        .col-md-6.col-lg-3
          .featurs-item.text-center.rounded.bg-light.p-4
            .featurs-icon.btn-square.rounded-circle.bg-secondary.mb-5.mx-auto
              i.fas.fa-user-shield.fa-3x.text-white
            .featurs-content.text-center
              h5 Security Payment
              p.mb-0 100% security payment
        .col-md-6.col-lg-3
          .featurs-item.text-center.rounded.bg-light.p-4
            .featurs-icon.btn-square.rounded-circle.bg-secondary.mb-5.mx-auto
              i.fas.fa-exchange-alt.fa-3x.text-white
            .featurs-content.text-center
              h5 30 Day Return
              p.mb-0 30 day money guarantee
        .col-md-6.col-lg-3
          .featurs-item.text-center.rounded.bg-light.p-4
            .featurs-icon.btn-square.rounded-circle.bg-secondary.mb-5.mx-auto
              i.fa.fa-phone-alt.fa-3x.text-white
            .featurs-content.text-center
