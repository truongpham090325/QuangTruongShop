extends ../layouts/default.pug

block main
  // Single Page Header start
  .container-fluid.page-header.py-5
    h1.text-center.text-white.display-6 Cart
    ol.breadcrumb.justify-content-center.mb-0
      li.breadcrumb-item
        a(href="#") Trang chủ
      li.breadcrumb-item.active.text-white Giỏ hàng
  // Single Page Header End
  // Cart Page Start
  .container-fluid.py-5
    .container.py-5
      .table-responsive
        table.table
          thead
            tr
              th(scope="col") Ảnh
              th(scope="col") Tên
              th(scope="col") Giá 
              th(scope="col") Số lượng
              th(scope="col") Tạm tính
              th(scope="col") Hành động
          tbody
            tr
              th(scope="row")
                .d-flex.align-items-center
                  img.img-fluid.me-5.rounded-circle(
                    alt="" 
                    style="width: 80px; height: 80px;" 
                    src="img/vegetable-item-3.png"
                    )
              td
                p.mb-0.mt-4 Big Banana
              td
                p.mb-0.mt-4 2.99 $
              td
                .input-group.quantity.mt-4(style="width: 100px;")
                  .input-group-btn
                    button.btn.btn-sm.btn-minus.rounded-circle.bg-light.border
                      i.fa.fa-minus
                  input.form-control.form-control-sm.text-center.border-0(
                    value="1" 
                    type="text"
                    )
                  .input-group-btn
                    button.btn.btn-sm.btn-plus.rounded-circle.bg-light.border
                      i.fa.fa-plus
              td
                p.mb-0.mt-4 2.99 $
              td
                button.btn.btn-md.rounded-circle.bg-light.border.mt-4
                  i.fa.fa-times.text-danger
      .row.g-4.justify-content-end
        .col-8
        .col-sm-8.col-md-7.col-lg-6.col-xl-4
          .bg-light.rounded
            .p-4
              h1.display-6.mb-4
                | Tổng giỏ hàng
              .d-flex.justify-content-between.mb-4
                h5.mb-0.me-4 Tạm tính:
                p.mb-0 0đ
              .d-flex.justify-content-between
                h5.mb-0.me-4 Giảm giá
                div
                  p.mb-0 -0đ
            .py-4.mb-4.border-top.border-bottom.d-flex.justify-content-between
              h5.mb-0.ps-4.me-4 Tổng tiền
              p.mb-0.pe-4 100.000đ
            button.btn.border-secondary.rounded-pill.px-4.py-3.text-primary.text-uppercase.mb-4.ms-4(type="button") Tiến hành thanh toán
  // Cart Page End