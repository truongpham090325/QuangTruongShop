extends ../layouts/default.pug

block main
  // Single Page Header start
  .container-fluid.page-header.py-5
    h1.text-center.text-white.display-6 Giỏ hàng
    ol.breadcrumb.justify-content-center.mb-0
      li.breadcrumb-item
        a(href="#") Trang chủ
      li.breadcrumb-item.active.text-white Giỏ hàng
  // Single Page Header End
  // Cart Page Start
  .container-fluid.py-5
    .container.py-5
      .table-responsive
        table.table
          thead
            tr
              th(scope="col") Ảnh
              th(scope="col") Tên
              th(scope="col") Giá 
              th(scope="col") Số lượng
              th(scope="col") Tạm tính
              th(scope="col") Đơn vị tính
              th(scope="col") Hành động
          tbody(cart-table)
      .row.g-4.justify-content-end
        .col-8
        .col-sm-8.col-md-7.col-lg-6.col-xl-4
          .bg-light.rounded
            .p-4
              h1.display-6.mb-4
                | Tổng giỏ hàng
              .d-flex.justify-content-between.mb-4
                h5.mb-0.me-4 Tạm tính:
                p.mb-0(sub-total) 0đ
              .d-flex.justify-content-between
                h5.mb-0.me-4 Giảm giá
                div
                  p.mb-0(discount) 0đ
            .py-4.mb-4.border-top.border-bottom.d-flex.justify-content-between
              h5.mb-0.ps-4.me-4 Tổng tiền
              p.mb-0.pe-4(total) 0đ
            a.btn.border-secondary.rounded-pill.px-4.py-3.text-primary.text-uppercase.mb-4.ms-4(href=`/checkout`) Tiến hành thanh toán
  // Cart Page End