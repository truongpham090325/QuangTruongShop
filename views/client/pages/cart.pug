extends ../layouts/default.pug

block main
  // Single Page Header start
  .container-fluid.page-header.py-5
    h1.text-center.text-white.display-6 Cart
    ol.breadcrumb.justify-content-center.mb-0
      li.breadcrumb-item
        a(href="#") Home
      li.breadcrumb-item
        a(href="#") Pages
      li.breadcrumb-item.active.text-white Cart
  // Single Page Header End
  // Cart Page Start
  .container-fluid.py-5
    .container.py-5
      .table-responsive
        table.table
          thead
            tr
              th(scope="col") Products
              th(scope="col") Name
              th(scope="col") Price
              th(scope="col") Quantity
              th(scope="col") Total
              th(scope="col") Handle
          tbody
            tr
              th(scope="row")
                .d-flex.align-items-center
                  img.img-fluid.me-5.rounded-circle(
                    alt="" 
                    style="width: 80px; height: 80px;" 
                    src="img/vegetable-item-3.png"
                    )
              td
                p.mb-0.mt-4 Big Banana
              td
                p.mb-0.mt-4 2.99 $
              td
                .input-group.quantity.mt-4(style="width: 100px;")
                  .input-group-btn
                    button.btn.btn-sm.btn-minus.rounded-circle.bg-light.border
                      i.fa.fa-minus
                  input.form-control.form-control-sm.text-center.border-0(
                    value="1" 
                    type="text"
                    )
                  .input-group-btn
                    button.btn.btn-sm.btn-plus.rounded-circle.bg-light.border
                      i.fa.fa-plus
              td
                p.mb-0.mt-4 2.99 $
              td
                button.btn.btn-md.rounded-circle.bg-light.border.mt-4
                  i.fa.fa-times.text-danger
            tr
              th(scope="row")
                .d-flex.align-items-center
                  img.img-fluid.me-5.rounded-circle(
                    alt="" 
                    style="width: 80px; height: 80px;" 
                    src="img/vegetable-item-5.jpg"
                    )
              td
                p.mb-0.mt-4 Potatoes
              td
                p.mb-0.mt-4 2.99 $
              td
                .input-group.quantity.mt-4(style="width: 100px;")
                  .input-group-btn
                    button.btn.btn-sm.btn-minus.rounded-circle.bg-light.border
                      i.fa.fa-minus
                  input.form-control.form-control-sm.text-center.border-0(
                    value="1" 
                    type="text"
                    )
                  .input-group-btn
                    button.btn.btn-sm.btn-plus.rounded-circle.bg-light.border
                      i.fa.fa-plus
              td
                p.mb-0.mt-4 2.99 $
              td
                button.btn.btn-md.rounded-circle.bg-light.border.mt-4
                  i.fa.fa-times.text-danger
            tr
              th(scope="row")
                .d-flex.align-items-center
                  img.img-fluid.me-5.rounded-circle(
                    alt="" 
                    style="width: 80px; height: 80px;" 
                    src="img/vegetable-item-2.jpg"
                    )
              td
                p.mb-0.mt-4 Awesome Brocoli
              td
                p.mb-0.mt-4 2.99 $
              td
                .input-group.quantity.mt-4(style="width: 100px;")
                  .input-group-btn
                    button.btn.btn-sm.btn-minus.rounded-circle.bg-light.border
                      i.fa.fa-minus
                  input.form-control.form-control-sm.text-center.border-0(
                    value="1" 
                    type="text"
                    )
                  .input-group-btn
                    button.btn.btn-sm.btn-plus.rounded-circle.bg-light.border
                      i.fa.fa-plus
              td
                p.mb-0.mt-4 2.99 $
              td
                button.btn.btn-md.rounded-circle.bg-light.border.mt-4
                  i.fa.fa-times.text-danger
      .mt-5
        input.border-0.border-bottom.rounded.me-5.py-3.mb-4(
          placeholder="Coupon Code" 
          type="text"
          )
        button.btn.border-secondary.rounded-pill.px-4.py-3.text-primary(type="button") Apply Coupon
      .row.g-4.justify-content-end
        .col-8
        .col-sm-8.col-md-7.col-lg-6.col-xl-4
          .bg-light.rounded
            .p-4
              h1.display-6.mb-4
                | Cart
                span.fw-normal Total
              .d-flex.justify-content-between.mb-4
                h5.mb-0.me-4 Subtotal:
                p.mb-0 $96.00
              .d-flex.justify-content-between
                h5.mb-0.me-4 Shipping
                div
                  p.mb-0 Flat rate: $3.00
              p.mb-0.text-end Shipping to Ukraine.
            .py-4.mb-4.border-top.border-bottom.d-flex.justify-content-between
              h5.mb-0.ps-4.me-4 Total
              p.mb-0.pe-4 $99.00
            button.btn.border-secondary.rounded-pill.px-4.py-3.text-primary.text-uppercase.mb-4.ms-4(type="button") Proceed Checkout
  // Cart Page End