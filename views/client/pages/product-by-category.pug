extends ../layouts/default.pug
include ../mixins/product-item.pug

block main
  // Single Page Header start
  .container-fluid.page-header.py-5
    h1.text-center.text-white.display-6 Shop
    ol.breadcrumb.justify-content-center.mb-0
      li.breadcrumb-item
        a(href="#") Home
      li.breadcrumb-item
        a(href="#") Pages
      li.breadcrumb-item.active.text-white Shop
  // Single Page Header End
  // Fruits Shop Start
  .container-fluid.fruite.py-5
    .container.py-5
      h1.mb-4 #{pageTitle}
      .row.g-4
        .col-lg-12
          .row.g-4
            .col-xl-3
              .input-group.w-100.mx-auto.d-flex
                input.form-control.p-3(
                  aria-describedby="search-icon-1" 
                  placeholder="keywords" 
                  type="search"
                  )
                span#search-icon-1.input-group-text.p-3
                  i.fa.fa-search
            .col-6
            .col-xl-3
              .bg-light.ps-3.py-3.rounded.d-flex.justify-content-between.mb-4
                label(for="fruits") Default Sorting:
                select#fruits.border-0.form-select-sm.bg-light.me-3(
                  form="fruitform" 
                  name="fruitlist"
                  )
                  option(value="volvo") Nothing
                  option(value="saab") Popularity
                  option(value="opel") Organic
                  option(value="audi") Fantastic
          .row.g-4
            .col-lg-3
              .row.g-4
                .col-lg-12
                  .mb-3
                    h4 Categories
                    ul.list-unstyled.fruite-categorie
                      li
                        .d-flex.justify-content-between.fruite-name
                          a(href="#")
                            i.fas.fa-apple-alt.me-2
                            | Apples
                          span (3)
                      li
                        .d-flex.justify-content-between.fruite-name
                          a(href="#")
                            i.fas.fa-apple-alt.me-2
                            | Oranges
                          span (5)
                      li
                        .d-flex.justify-content-between.fruite-name
                          a(href="#")
                            i.fas.fa-apple-alt.me-2
                            | Strawbery
                          span (2)
                      li
                        .d-flex.justify-content-between.fruite-name
                          a(href="#")
                            i.fas.fa-apple-alt.me-2
                            | Banana
                          span (8)
                      li
                        .d-flex.justify-content-between.fruite-name
                          a(href="#")
                            i.fas.fa-apple-alt.me-2
                            | Pumpkin
                          span (5)
                .col-lg-12
                  .mb-3
                    h4.mb-2 Price
                    input#rangeInput.form-range.w-100(
                      oninput="amount.value=rangeInput.value" 
                      value="0" 
                      max="500" 
                      min="0" 
                      name="rangeInput" 
                      type="range"
                      )
                    output#amount(
                      for="rangeInput" 
                      max-value="500" 
                      min-velue="0" 
                      name="amount"
                      ) 0
                .col-lg-12
                  .mb-3
                    h4 Additional
                    .mb-2
                      input#Categories-1.me-2(
                        value="Beverages" 
                        name="Categories-1" 
                        type="radio"
                        )
                      label(for="Categories-1") Organic
                    .mb-2
                      input#Categories-2.me-2(
                        value="Beverages" 
                        name="Categories-1" 
                        type="radio"
                        )
                      label(for="Categories-2") Fresh
                    .mb-2
                      input#Categories-3.me-2(
                        value="Beverages" 
                        name="Categories-1" 
                        type="radio"
                        )
                      label(for="Categories-3") Sales
                    .mb-2
                      input#Categories-4.me-2(
                        value="Beverages" 
                        name="Categories-1" 
                        type="radio"
                        )
                      label(for="Categories-4") Discount
                    .mb-2
                      input#Categories-5.me-2(
                        value="Beverages" 
                        name="Categories-1" 
                        type="radio"
                        )
                      label(for="Categories-5") Expired
                .col-lg-12
                  h4.mb-3 Featured products
                  .d-flex.align-items-center.justify-content-start
                    .rounded.me-4(style="width: 100px; height: 100px;")
                      img.img-fluid.rounded(
                        alt="" 
                        src="/client/assets/img/featur-1.jpg"
                        )
                    div
                      h6.mb-2 Big Banana
                      .d-flex.mb-2
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star
                      .d-flex.mb-2
                        h5.fw-bold.me-2 2.99 $
                        h5.text-danger.text-decoration-line-through 4.11 $
                  .d-flex.align-items-center.justify-content-start
                    .rounded.me-4(style="width: 100px; height: 100px;")
                      img.img-fluid.rounded(
                        alt="" 
                        src="/client/assets/img/featur-2.jpg"
                        )
                    div
                      h6.mb-2 Big Banana
                      .d-flex.mb-2
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star
                      .d-flex.mb-2
                        h5.fw-bold.me-2 2.99 $
                        h5.text-danger.text-decoration-line-through 4.11 $
                  .d-flex.align-items-center.justify-content-start
                    .rounded.me-4(style="width: 100px; height: 100px;")
                      img.img-fluid.rounded(
                        alt="" 
                        src="/client/assets/img/featur-3.jpg"
                        )
                    div
                      h6.mb-2 Big Banana
                      .d-flex.mb-2
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star.text-secondary
                        i.fa.fa-star
                      .d-flex.mb-2
                        h5.fw-bold.me-2 2.99 $
                        h5.text-danger.text-decoration-line-through 4.11 $
                  .d-flex.justify-content-center.my-4
                    a.btn.border.border-secondary.px-4.py-3.rounded-pill.text-primary.w-100(href="#") Vew More
                .col-lg-12
                  .position-relative
                    img.img-fluid.w-100.rounded(
                      alt="" 
                      src="/client/assets/img/banner-fruits.jpg"
                      )
                    .position-absolute(style="top: 50%; right: 10px; transform: translateY(-50%);")
                      h3.text-secondary.fw-bold
                        | Fresh
                        br
                        | Fruits
                        br
                        | Banner
            .col-lg-9
              .row.g-4.justify-content-center
                if products && products.length > 0
                  each item in products
                    +product-item(item)
                else
                  .col-12.text-center
                    p Không có sản phẩm nào trong danh mục này.
                .col-12
                  .pagination.d-flex.justify-content-center.mt-5
                    a.rounded(href="#") «
                    a.active.rounded(href="#") 1
                    a.rounded(href="#") 2
                    a.rounded(href="#") 3
                    a.rounded(href="#") 4
                    a.rounded(href="#") 5
                    a.rounded(href="#") 6
                    a.rounded(href="#") »
  // Fruits Shop End