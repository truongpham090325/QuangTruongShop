            //-           spellcheck="false" 
            //-           placeholder="Your Review *" 
            //-           rows="8" 
            //-           cols="30" 
            //-           name=""
            //-           )
            //-     .col-lg-12
            //-       .d-flex.justify-content-between.py-3.mb-5
            //-         .d-flex.align-items-center
            //-           p.mb-0.me-3 Please rate:
            //-           .d-flex.align-items-center(style="font-size: 12px;")
            //-             i.fa.fa-star.text-muted
            //-             i.fa.fa-star
            //-             i.fa.fa-star
            //-             i.fa.fa-star
            //-             i.fa.fa-star
            //-         a.btn.border.border-secondary.text-primary.rounded-pill.px-4.py-3(href="#") Post Comment
          h1.fw-bold.mb-0 Sản phẩm liên quan
      .vesitable
        .owl-carousel.vegetable-carousel.justify-content-center
          if relatedProduct && relatedProduct.length > 0
            each item in relatedProduct
              +product-item(item, "")
