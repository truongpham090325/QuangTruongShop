extends ../layouts/default.pug

block main
  // Single Page Header start
  .container-fluid.page-header.py-5
    h1.text-center.text-white.display-6 Shop Detail
    ol.breadcrumb.justify-content-center.mb-0
      li.breadcrumb-item
        a(href="#") Home
      li.breadcrumb-item
        a(href="#") Pages
      li.breadcrumb-item.active.text-white Shop Detail
  // Single Page Header End
  // Single Product Start
  .container-fluid.py-5.mt-5
    .container.py-5
      .row.g-4.mb-5
        .col-lg-8.col-xl-9
          .row.g-4
            .col-lg-6
              .border.rounded
                a(href="#")
                  img.img-fluid.rounded(
                    alt=product.name 
                    src=(product.images && product.images.length > 0 ? `${domainCDN}${product.images[0]}` : "/client/assets/img/single-item.jpg")
                    )
            .col-lg-6
              h4.fw-bold.mb-3 #{product.name}
              p.mb-3 Category: #{product.category && product.category.length > 0 ? product.category.join(', ') : 'Chưa phân loại'}
              .d-flex.align-items-center.mb-3
                if product.priceNew
                  h5.fw-bold.text-primary.mb-0.me-2 #{product.priceNew.toLocaleString("vi-VN")} đ
                if product.priceOld
                  del.text-muted.me-2 #{product.priceOld.toLocaleString("vi-VN")} đ
                if product.discount > 0
                  span.badge.bg-danger -#{product.discount}%
              .d-flex.mb-4
                i.fa.fa-star.text-secondary
                i.fa.fa-star.text-secondary
                i.fa.fa-star.text-secondary
                i.fa.fa-star.text-secondary
                i.fa.fa-star
              p.mb-4 !{product.description}
              .input-group.quantity.mb-5(style="width: 100px;")
                .input-group-btn
                  button.btn.btn-sm.btn-minus.rounded-circle.bg-light.border
                    i.fa.fa-minus
                input.form-control.form-control-sm.text-center.border-0(
                  value="1" 
                  type="text"
                  )
                .input-group-btn
                  button.btn.btn-sm.btn-plus.rounded-circle.bg-light.border
                    i.fa.fa-plus
              a.btn.border.border-secondary.rounded-pill.px-4.py-2.mb-4.text-primary(href="#")
                i.fa.fa-shopping-bag.me-2.text-primary
                | Add to cart
            .col-lg-12
              nav
                .nav.nav-tabs.mb-3
                  button#nav-about-tab.nav-link.active.border-white.border-bottom-0(
                    aria-selected="true" 
                    aria-controls="nav-about" 
                    data-bs-target="#nav-about" 
                    data-bs-toggle="tab" 
                    role="tab" 
                    type="button"
                    ) Description
                  button#nav-mission-tab.nav-link.border-white.border-bottom-0(
                    aria-selected="false" 
                    aria-controls="nav-mission" 
                    data-bs-target="#nav-mission" 
                    data-bs-toggle="tab" 
                    role="tab" 
                    type="button"
                    ) Reviews
              .tab-content.mb-5
                #nav-about.tab-pane.active(
                  aria-labelledby="nav-about-tab" 
                  role="tabpanel"
                  )
                  if product.content
                    div !{product.content}
                  else if product.description
                    p #{product.description}
                  else
                    p Đang cập nhật thông tin chi tiết...
                  .px-2
                    .row.g-4
                      .col-6
                        .row.bg-light.align-items-center.text-center.justify-content-center.py-2
                          .col-6
                            p.mb-0 Weight
                          .col-6
                            p.mb-0 1 kg
                        .row.text-center.align-items-center.justify-content-center.py-2
                          .col-6
                            p.mb-0 Country of Origin
                          .col-6
                            p.mb-0 Agro Farm
                        .row.bg-light.text-center.align-items-center.justify-content-center.py-2
                          .col-6
                            p.mb-0 Quality
                          .col-6
                            p.mb-0 Organic
                        .row.text-center.align-items-center.justify-content-center.py-2
                          .col-6
                            p.mb-0 Сheck
                          .col-6
                            p.mb-0 Healthy
                        .row.bg-light.text-center.align-items-center.justify-content-center.py-2
                          .col-6
                            p.mb-0 Min Weight
                          .col-6
                            p.mb-0 250 Kg
                #nav-mission.tab-pane(
                  aria-labelledby="nav-mission-tab" 
                  role="tabpanel"
                  )
                  .d-flex
                    img.img-fluid.rounded-circle.p-3(
                      alt="" 
                      style="width: 100px; height: 100px;" 
                      src="/client/assets/img/avatar.jpg"
                      )
                    div
                      p.mb-2(style="font-size: 14px;") April 12, 2024
                      .d-flex.justify-content-between
                        h5 Jason Smith
                        .d-flex.mb-3
                          i.fa.fa-star.text-secondary
                          i.fa.fa-star.text-secondary
                          i.fa.fa-star.text-secondary
                          i.fa.fa-star.text-secondary
                          i.fa.fa-star
                      p
                        | The generated Lorem Ipsum is therefore always free from repetition injected humour, or non-characteristic 
                        |   words etc. Susp endisse ultricies nisi vel quam suscipit
                  .d-flex
                    img.img-fluid.rounded-circle.p-3(
