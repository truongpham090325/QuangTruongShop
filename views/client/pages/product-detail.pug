extends ../layouts/default.pug
include ../mixins/product-item.pug

block main
  // Single Page Header start
  .container-fluid.page-header.py-5
    h1.text-center.text-white.display-6 Chi tiết sản phẩm
    ol.breadcrumb.justify-content-center.mb-0
      li.breadcrumb-item
        a(href="/") Trang chủ
      li.breadcrumb-item.active.text-white Chi tiết sản phẩm
  // Single Page Header End
  // Single Product Start
  .container-fluid.py-5.mt-5
    .container.py-5
      .row.g-4.mb-5
        .col-lg-8.col-xl-12
          .row.g-4
            .col-lg-6
              .border.rounded
                a(href="#")
                  img.img-fluid.rounded(
                    alt=product.name 
                    src=(product.images && product.images.length > 0 ? `${domainCDN}${product.images[0]}` : "/client/assets/img/single-item.jpg")
                    )
            .col-lg-6
              h4.fw-bold.mb-3 #{product.name}
              .d-flex.align-items-center.mb-3
                if product.priceNew
                  h5.fw-bold.text-primary.mb-0.me-2 #{product.priceNew.toLocaleString("vi-VN")} đ
                if product.priceOld
                  del.text-muted.me-2 #{product.priceOld.toLocaleString("vi-VN")} đ
                if product.discount > 0
                  span.badge.bg-danger -#{product.discount}%
              .d-flex.mb-4
                i.fa.fa-star.text-secondary
                i.fa.fa-star.text-secondary
                i.fa.fa-star.text-secondary
                i.fa.fa-star.text-secondary
                i.fa.fa-star
              p.mb-4 !{product.description}
              .input-group.quantity.mb-5(style="width: 100px;")
                .input-group-btn
                  button.btn.btn-sm.btn-minus.rounded-circle.bg-light.border
                    i.fa.fa-minus
                input.form-control.form-control-sm.text-center.border-0(
                  value="1" 
                  type="text"
                  )
                .input-group-btn
                  button.btn.btn-sm.btn-plus.rounded-circle.bg-light.border
                    i.fa.fa-plus
              a.btn.border.border-secondary.rounded-pill.px-4.py-2.mb-4.text-primary(href="#")
                i.fa.fa-shopping-bag.me-2.text-primary
                | Thêm vào giỏ
            .col-lg-12
              nav
                .nav.nav-tabs.mb-3
                  button#nav-about-tab.nav-link.active.border-white.border-bottom-0(
                    aria-selected="true" 
                    aria-controls="nav-about" 
                    data-bs-target="#nav-about" 
                    data-bs-toggle="tab" 
                    role="tab" 
                    type="button"
                    ) Mô tả
              .tab-content.mb-5
                #nav-about.tab-pane.active(
                  aria-labelledby="nav-about-tab" 
                  role="tabpanel"
                  )
                  if product.content
                    div !{product.content}
                  else if product.description
                    p #{product.description}
                  else
                    p Đang cập nhật thông tin chi tiết...
            //- form(action="#")
