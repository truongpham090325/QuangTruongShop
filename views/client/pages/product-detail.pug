                    | Diam dolor diam ipsum et tempor sit. Aliqu diam amet diam et eos labore.
                    |   Clita erat ipsum et lorem et sit
            form(action="#")
              h4.mb-5.fw-bold Leave a Reply
              .row.g-4
                .col-lg-6
                  .border-bottom.rounded
                    input.form-control.border-0.me-4(
                      placeholder="Yur Name *" 
                      type="text"
                      )
                .col-lg-6
                  .border-bottom.rounded
                    input.form-control.border-0(
                      placeholder="Your Email *" 
                      type="email"
                      )
                .col-lg-12
                  .border-bottom.rounded.my-4
                    textarea.form-control.border-0(
                      spellcheck="false" 
                      placeholder="Your Review *" 
                      rows="8" 
                      cols="30" 
                      name=""
                      )
                .col-lg-12
                  .d-flex.justify-content-between.py-3.mb-5
                    .d-flex.align-items-center
                      p.mb-0.me-3 Please rate:
                      .d-flex.align-items-center(style="font-size: 12px;")
                        i.fa.fa-star.text-muted
                        i.fa.fa-star
                        i.fa.fa-star
                        i.fa.fa-star
                        i.fa.fa-star
                    a.btn.border.border-secondary.text-primary.rounded-pill.px-4.py-3(href="#") Post Comment
