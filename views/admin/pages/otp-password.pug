extends ../layouts/blank.pug

block main
  .container-xxl
    .row.vh-100.d-flex.justify-content-center
      .col-12.align-self-center
        .card-body
          .row
            .col-lg-4.mx-auto
              .card
                .card-body.p-0.bg-black.auth-header-box.rounded-top
                  .text-center.p-3
                    a.logo.logo-admin(href="#")
                      img.auth-logo(
                        alt="logo" 
                        height="50" 
                        src="/admin/assets/images/logo-sm.png"
                        )
                    h4.mt-3.mb-1.fw-semibold.text-white.fs-18 #{pageTitle}
                .card-body.pt-0
                  form.my-4(id="otpPasswordForm")
                    .form-group.mb-2
                      label.form-label(for="email") Email
                      input#email.form-control(
                        placeholder="Nhập email" 
                        name="email" 
                        type="email"
                        readonly
                        value=email
                        )
                      label.form-label(for="otp") Mã OTP
                      input#otp.form-control(
                        placeholder="Nhập otp" 
                        name="otp" 
                        type="text"
                        )
                    // end form-group
                    .form-group.mb-0.row
                      .col-12
                        .d-grid.mt-3
                          button.btn.btn-primary
                            | Xác thực
                            i.fas.fa-sign-in-alt.ms-1
                      // end col
                    // end form-group
                  // end form
