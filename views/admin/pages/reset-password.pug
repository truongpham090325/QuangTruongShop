extends ../layouts/blank.pug

block main
  .container-xxl
    .row.vh-100.d-flex.justify-content-center
      .col-12.align-self-center
        .card-body
          .row
            .col-lg-4.mx-auto
              .card
                .card-body.p-0.bg-black.auth-header-box.rounded-top
                  .text-center.p-3
                    a.logo.logo-admin(href="#")
                      img.auth-logo(
                        alt="logo" 
                        height="50" 
                        src="/admin/assets/images/logo-sm.png"
                        )
                    h4.mt-3.mb-1.fw-semibold.text-white.fs-18 #{pageTitle}
                .card-body.pt-0
                  form.my-4(id="resetPasswordForm")
                    .form-group.mb-2
                      label.form-label(for="password") Mật khẩu mới
                      input#password.form-control(
                        placeholder="************" 
                        name="password" 
                        type="password"
                        )
                    .form-group.mb-2
                      label.form-label(for="confirmPassword") Xác nhận mật khẩu mới
                      input#confirmPassword.form-control(
                        placeholder="********" 
                        type="password"
                        name="confirmPassword"
                        )
                    // end form-group
                    .form-group.mb-0.row
                      .col-12
                        .d-grid.mt-3
                          button.btn.btn-primary
                            | Đổi mật khẩu
                            i.fas.fa-sign-in-alt.ms-1
                      // end col
                    // end form-group
                  // end form
