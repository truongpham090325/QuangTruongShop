extends ../layouts/default.pug
include ../mixins/form-group-file.pug
include ../mixins/checkbox-list.pug

block main
  if (permissions.includes("product-create"))
    .card
      .card-header
        .row.align-items-center
          .col
            h4.card-title #{pageTitle}
      .card-body.pt-0
        form(id="productCreateForm")
          .row
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="name") Tên sản phẩm *
                input.form-control(id="name" type="text" name="name")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="slug") Đường dẫn *
                .input-group
                  span.btn.btn-outline-info(
                    btn-generate-slug="Product" 
                    from="name"
                    to="slug"
                  ) Tự động
                  input.form-control(id="slug" type="text" name="slug")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="position") Vị trí
                input.form-control(id="position" type="number" name="position")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="status") Trạng thái
                select.form-select(id="status" name="status")
                  option(value="active") Hoạt động
                  option(value="inactive") Tạm dừng
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Danh mục
                div(class="checkbox-list" checkbox-list="category")
                  +checkbox-list(categoryList)
            if (permissions.includes("view-price-old"))
              .col-md-6.col-lg-6
                .mb-3
                  label.form-label(for="priceOld") Giá nhập
                  input.form-control(id="priceOld" type="number" name="priceOld")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="priceNew") Giá bán
                input.form-control(id="priceNew" type="number" name="priceNew")
            .col-md-6.col-lg-6
              .mb-3
                label.form-label(for="stock") Tổng số lượng
                input.form-control(id="stock" type="number" name="stock" readonly value="0")
            each w in warehouses
              .col-md-4.col-lg-4
                .mb-3
                  label.form-label Tồn kho tại #{w.name}
                  input.form-control.warehouse-stock-input(
                    type="number"
                    min="0"
                    value="0"
                    data-warehouse-id=w.id
                  )
            .col-md-12.col-lg-12
              .mb-3
                label.form-label Danh sách ảnh
                div(class="form-multi-file")
                  .input-group
                    span.btn.btn-outline-info(
                      data-bs-toggle="modal"
                      data-bs-target="#modalFileManager"
                    ) Chọn file
                    span.btn.btn-outline-info(
                      button-paste
                    ) Dán file
                  .inner-list-image(multi-file="images")
                    //- .inner-image
                    //-   img(src="https://placehold.co/100x100/EEE/31343C", alt="")
                    //-   span.inner-remove x
                    //- .inner-image
                    //-   img(src="https://placehold.co/100x100/EEE/31343C", alt="")
                    //-   span.inner-remove x
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="description") Mô tả ngắn
                textarea(id="description" name="description" textarea-mce)
            .col-md-12.col-lg-12
              .mb-3
                label.form-label(for="content") Nội dung chi tiết
                textarea(id="content" name="content" textarea-mce)      
          button.btn.btn-primary(type="submit") Tạo mới
          a.btn.btn-danger.ms-1(href=`/${pathAdmin}/product/list`) Hủy
