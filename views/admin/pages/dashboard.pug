extends ../layouts/default.pug

block main
  if (permissions.includes("dashboard"))
    style.
      .stats-card {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        border-radius: 12px !important;
        overflow: hidden;
      }
      .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.08) !important;
      }
      .icon-container {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        transition: all 0.3s ease;
      }
      .stats-card:hover .icon-container {
        transform: scale(1.1) rotate(5deg);
      }
      .bg-gradient-blue {
        background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(37, 99, 235, 0.05) 100%);
        color: #2563eb;
      }
      .bg-gradient-green {
        background: linear-gradient(135deg, rgba(34, 197, 94, 0.15) 0%, rgba(22, 163, 74, 0.05) 100%);
        color: #16a34a;
      }
      .bg-gradient-cyan {
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.15) 0%, rgba(8, 145, 178, 0.05) 100%);
        color: #0891b2;
      }
      .bg-gradient-orange {
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.15) 0%, rgba(234, 88, 12, 0.05) 100%);
        color: #ea580c;
      }
      .card-chart {
        border-radius: 12px !important;
        border: none !important;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.03) !important;
      }
      .badge-subtle-success {
        background-color: rgba(34, 197, 94, 0.12);
        color: #16a34a;
        font-weight: 600;
      }
      .badge-subtle-info {
        background-color: rgba(14, 165, 233, 0.12);
        color: #0284c7;
        font-weight: 600;
      }
      .badge-subtle-warning {
        background-color: rgba(234, 179, 8, 0.12);
        color: #a16207;
        font-weight: 600;
      }
      .table-hover tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.01) !important;
      }
      .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .pulse-animation {
        animation: pulse 2s infinite;
      }
      @keyframes pulse {
        0% {
          box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4);
        }
        70% {
          box-shadow: 0 0 0 10px rgba(34, 197, 94, 0);
        }
        100% {
          box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
        }
      }

    .row
      .col-12
        .page-title-box.d-md-flex.justify-content-between.align-items-center.my-3
          h4.mb-0.fw-bold.text-dark Thống kê & Phân tích Kinh doanh
          .text-muted.font-13 Báo cáo tự động dựa trên các đơn hàng hoàn tất & thanh toán thành công.

    // Stats Counters
    .row.mb-4
      .col-md-6.col-xl-3.mb-3
        .card.stats-card.shadow-sm.border-0.h-100
          .card-body.p-4
            .d-flex.justify-content-between.align-items-center
              div
                p.text-muted.text-uppercase.fw-semibold.font-12.mb-1 Đơn Hàng Thành Công
                h3.mb-2.fw-bold.text-dark #{stats.completedOrders} / #{stats.totalOrders}
                span.badge.badge-subtle-success.me-1 #{stats.totalOrders > 0 ? Math.round((stats.completedOrders / stats.totalOrders) * 100) : 0}%
                span.text-muted.font-11 tỷ lệ hoàn tất
              .icon-container.bg-gradient-blue
                i.las.la-shopping-cart.fs-24
                
      .col-md-6.col-xl-3.mb-3
        .card.stats-card.shadow-sm.border-0.h-100
          .card-body.p-4
            .d-flex.justify-content-between.align-items-center
              div
                p.text-muted.text-uppercase.fw-semibold.font-12.mb-1 Tổng Doanh Thu
                h3.mb-2.fw-bold.text-success #{stats.totalRevenue.toLocaleString("vi-VN")} đ
                span.badge.badge-subtle-info.me-1 Giao dịch thành công
              .icon-container.bg-gradient-green.pulse-animation
                i.las.la-money-bill-wave.fs-24
                
      .col-md-6.col-xl-3.mb-3
        .card.stats-card.shadow-sm.border-0.h-100
          .card-body.p-4
            .d-flex.justify-content-between.align-items-center
              div
                p.text-muted.text-uppercase.fw-semibold.font-12.mb-1 Tổng Lợi Nhuận
                h3.mb-2.fw-bold.text-info #{stats.totalProfit.toLocaleString("vi-VN")} đ
                span.badge.badge-subtle-success.me-1 Giá bán - Giá nhập
              .icon-container.bg-gradient-cyan
                i.las.la-chart-line.fs-24
                
      .col-md-6.col-xl-3.mb-3
        .card.stats-card.shadow-sm.border-0.h-100
          .card-body.p-4
            .d-flex.justify-content-between.align-items-center
              div
                p.text-muted.text-uppercase.fw-semibold.font-12.mb-1 Tỷ Suất Lợi Nhuận
                h3.mb-2.fw-bold.text-warning #{stats.totalRevenue > 0 ? ((stats.totalProfit / stats.totalRevenue) * 100).toFixed(1) : 0}%
                span.text-muted.font-11 lợi nhuận ròng / doanh thu
              .icon-container.bg-gradient-orange
                i.las.la-percent.fs-24

    // Daily Chart
    .row.mb-4
      .col-12.mb-3
        .card.card-chart.shadow-sm.h-100
          .card-header.bg-transparent.border-0.pt-4.px-4.d-flex.justify-content-between.align-items-center
            h5.card-title.mb-0.fw-bold Doanh thu & Lợi nhuận theo Ngày (30 ngày gần nhất)
            span.badge.bg-success-subtle.text-success.px-2.py-1 Đơn vị: VNĐ
          .card-body.px-4.pb-4
            #dailyChart
            
    // Monthly Chart
    .row.mb-4
      .col-12.mb-3
        .card.card-chart.shadow-sm.h-100
          .card-header.bg-transparent.border-0.pt-4.px-4.d-flex.justify-content-between.align-items-center
            h5.card-title.mb-0.fw-bold Doanh thu & Lợi nhuận theo Tháng (Trong năm)
            span.badge.bg-primary-subtle.text-primary.px-2.py-1 Năm #{new Date().getFullYear()}
          .card-body.px-4.pb-4
            #monthlyChart
            
    // Yearly Table and Product Details List
    .row.mb-4
      .col-lg-6.mb-3
        .card.card-chart.shadow-sm.h-100
          .card-header.bg-transparent.border-0.pt-4.px-4
            h5.card-title.mb-0.fw-bold Báo cáo Doanh thu & Lợi nhuận theo Năm
          .card-body.px-4.pb-4
            .table-responsive
              table.table.table-hover.align-middle.mb-0
                thead.table-light
                  tr
                    th Năm
                    th.text-center Số đơn hàng
                    th.text-end Doanh thu
                    th.text-end Lợi nhuận
                    th.text-end Tỷ suất
                tbody
                  if rawYearlyList && rawYearlyList.length > 0
                    each item in rawYearlyList
                      tr
                        td.fw-bold.text-primary Năm #{item.year}
                        td.text-center #{item.count}
                        td.text-end.text-success.fw-bold #{item.revenue.toLocaleString("vi-VN")} đ
                        td.text-end.text-info.fw-bold #{item.profit.toLocaleString("vi-VN")} đ
                        td.text-end
                          span.badge.badge-subtle-warning #{item.revenue > 0 ? ((item.profit / item.revenue) * 100).toFixed(1) : 0}%
                  else
                    tr
                      td(colspan="5" class="text-center text-muted py-4") Chưa có dữ liệu thống kê năm.
                      
      .col-lg-6.mb-3
        .card.card-chart.shadow-sm.h-100
          .card-header.bg-transparent.border-0.pt-4.px-4
            h5.card-title.mb-0.fw-bold Chi tiết Top 5 Sản phẩm Hiệu quả nhất
          .card-body.px-4.pb-4
            .table-responsive
              table.table.table-hover.align-middle.mb-0
                thead.table-light
                  tr
                    th Sản phẩm
                    th.text-center Số lượng bán
                    th.text-end Doanh thu ước tính
                    th.text-end Lợi nhuận ròng
                tbody
                  - const parsedProducts = JSON.parse(topProducts)
                  if parsedProducts && parsedProducts.length > 0
                    each item in parsedProducts
                      tr
                        td
                          span.fw-semibold.text-dark.text-truncate-2(title=item.name) #{item.name}
                        td.text-center.fw-bold.text-secondary #{item.quantity}
                        td.text-end.text-muted #{item.revenue.toLocaleString("vi-VN")} đ
                        td.text-end.fw-bold.text-success #{item.profit.toLocaleString("vi-VN")} đ
                  else
                    tr
                      td(colspan="4" class="text-center text-muted py-4") Chưa bán được sản phẩm nào hoặc chưa khớp giá nhập.

block script
  script(src="/admin/assets/libs/apexcharts/apexcharts.min.js")
  script.
    document.addEventListener("DOMContentLoaded", function() {
      const dailyEl = document.querySelector("#dailyChart");
      const monthlyEl = document.querySelector("#monthlyChart");
      if (!dailyEl || !monthlyEl) return;

      // Safe injection of data from controller
      const dailyData = !{last30DaysList};
      const monthlyData = !{last12MonthsList};
      const statusCounts = !{JSON.stringify(statusCounts)};
      const topProducts = !{topProducts};

      // Common Chart options
      const fontOptions = {
        fontFamily: 'Be Vietnam Pro, sans-serif',
        colors: '#888'
      };

      // 1. Daily Chart (Area representation)
      const dailyCategories = dailyData.map(d => d.date);
      const dailyRevenue = dailyData.map(d => d.revenue);
      const dailyProfit = dailyData.map(d => d.profit);

      const dailyOptions = {
        series: [
          { name: "Doanh thu", data: dailyRevenue },
          { name: "Lợi nhuận thực tế", data: dailyProfit }
        ],
        chart: {
          type: 'area',
          height: 350,
          toolbar: { show: false },
          dropShadow: { enabled: true, top: 4, left: 0, bottom: 0, right: 0, blur: 3, opacity: 0.05 }
        },
        colors: ['#22c55e', '#0ea5e9'],
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 2.5 },
        xaxis: { 
          categories: dailyCategories,
          labels: { style: fontOptions }
        },
        yaxis: {
          labels: {
            style: fontOptions,
            formatter: function(val) {
              if (val >= 1000000) return (val / 1000000).toFixed(1) + 'M';
              if (val >= 1000) return (val / 1000).toFixed(0) + 'k';
              return val;
            }
          }
        },
        tooltip: {
          theme: 'light',
          y: {
            formatter: function(val) {
              return val.toLocaleString('vi-VN') + ' đ';
            }
          }
        },
        fill: {
          type: 'gradient',
          gradient: {
            shadeIntensity: 1,
            opacityFrom: 0.4,
            opacityTo: 0.02,
            stops: [0, 100]
          }
        },
        grid: { borderColor: '#f1f1f1' }
      };
      new ApexCharts(dailyEl, dailyOptions).render();



      // 3. Monthly Chart (Double Bar representation)
      const monthlyCategories = monthlyData.map(m => m.month);
      const monthlyRevenue = monthlyData.map(m => m.revenue);
      const monthlyProfit = monthlyData.map(m => m.profit);

      const monthlyOptions = {
        series: [
          { name: "Doanh thu", data: monthlyRevenue },
          { name: "Lợi nhuận", data: monthlyProfit }
        ],
        chart: { type: 'bar', height: 350, toolbar: { show: false } },
        colors: ['#22c55e', '#0ea5e9'],
        plotOptions: {
          bar: {
            horizontal: false,
            columnWidth: '45%',
            borderRadius: 6,
            borderRadiusApplication: 'around'
          }
        },
        dataLabels: { enabled: false },
        xaxis: { 
          categories: monthlyCategories,
          labels: { style: fontOptions }
        },
        yaxis: {
          labels: {
            style: fontOptions,
            formatter: function(val) {
              if (val >= 1000000) return (val / 1000000).toFixed(1) + 'M';
              if (val >= 1000) return (val / 1000).toFixed(0) + 'k';
              return val;
            }
          }
        },
        tooltip: {
          y: {
            formatter: function(val) {
              return val.toLocaleString('vi-VN') + ' đ';
            }
          }
        },
        grid: { borderColor: '#f1f1f1' }
      };
      new ApexCharts(monthlyEl, monthlyOptions).render();


    });